      "^/index.pl\\?logout_all$": "logout_app_sso http://lemonldap-ng.org/welcome/",
      "^/index.pl\\?logout_app$": "logout_app http://test1.example.com:19876/index.pl?foo=1",
      "^/logout": "logout_sso",
      "^/saml": "unprotect",
      "default": "accept"
    },

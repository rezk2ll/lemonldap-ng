#!/usr/bin/perl
#
use warnings;
use strict;
use POSIX;
use Lemonldap::NG::Common::Conf;
use Lemonldap::NG::Common::Apache::Session;
use Lemonldap::NG::Common::Session;
use Lemonldap::NG::Common::TOTP;
use JSON         qw(from_json to_json);
use Getopt::Long qw(:config auto_help);
use Pod::Usage;

my ( $dryrun, $verbose, $interval, $algorithm, $digits );
GetOptions(
    "n|dry-run"     => \$dryrun,
    "v|verbose"     => \$verbose,
    "interval|i=s"  => \$interval,
    "algorithm|a=s" => \$algorithm,
    "digits|d=s"    => \$digits,
);

eval {
    POSIX::setgid( scalar( getgrnam('www-data') ) );
    POSIX::setuid( scalar( getpwnam('www-data') ) );
    my ( undef, undef, undef, undef, undef, undef, undef, $homedir, undef ) =
      getpwnam('www-data');
    $ENV{HOME} = $homedir if $homedir;
};

if ( not $interval or not $digits or not $algorithm ) {
    die "interval, digits and algorithm options are required.\n"
      . "They must match the parameters of LemonLDAP::NG 2.0\n";
}

if ( $interval !~ /^\d+$/ ) {
    die "interval must be a number\n";
}

if ( $digits !~ /^\d+$/ ) {
    die "digits must be a number\n";
}

if ( $algorithm !~ /^sha(?:1|256|512)$/ ) {
    die "algorithm [$algorithm] must be sha1, sha256 or sha512\n";
}

sub verbose {
    print STDERR @_, "\n" if $verbose;
}

sub info {
    print STDERR @_, "\n";
}

# Get config
my $res = Lemonldap::NG::Common::Conf->new();
die $Lemonldap::NG::Common::Conf::msg unless ($res);
my $conf = $res->getConf();

my $localconf = $res->getLocalConf()
  or die "Unable to get local configuration ($!)";

if ($localconf) {
    $conf->{$_} = $localconf->{$_} foreach ( keys %$localconf );
}

# Search psessions
my $args;
if ( $conf->{"persistentStorage"} ) {
    $args = $conf->{"persistentStorageOptions"};
    $args->{backend} = $conf->{"persistentStorage"};
}
else {
    $args = $conf->{"globalStorageOptions"};
    $args->{backend} = $conf->{"globalStorage"};
}

verbose "Searching for persistent sessions";
$res = Lemonldap::NG::Common::Apache::Session->searchOn( $args, '_session_kind',
    'Persistent', '_2fDevices', '_session_uid' );

if ( ref($res) eq "HASH" ) {
    verbose "Found " . scalar( keys %{$res} ) . " persistent sessions";

    # For each found psession
    for my $k ( keys %{$res} ) {
        my $_2fDevices = $res->{$k}->{_2fDevices};
        my $uid        = $res->{$k}->{_session_uid};
        verbose "Processing psession $k for user $uid";
        update_storage( $k, $uid, $_2fDevices );
    }
}
else {
    die "Could not find any persistent sessions";
}

sub update_storage {
    my ( $k, $uid, $_2fDevices ) = @_;

    eval {
        # parse _2fDevices if found
        if ($_2fDevices) {
            $_2fDevices = from_json($_2fDevices);

            # If the session has 2f devices
            if ( ref($_2fDevices) eq "ARRAY" and @{$_2fDevices} > 0 ) {
                my $changed =
                  convert_registrations_for_user( $uid, $_2fDevices );
                if ( $changed and !$dryrun ) {
                    eval { update2fArray( $k, $_2fDevices ); };
                    if ($@) {
                        info "Error updating session for $uid: $@";
                    }
                }
            }
            else {
                verbose "User $uid does not have a TOTP";
            }
        }
        else {
            verbose "User $uid does not have a TOTP";
        }

    };
    if ($@) {
        verbose "Error on psession $k: $@";
    }
}

sub update2fArray {
    my ( $id, $_2fDevices ) = @_;

    my $session = Lemonldap::NG::Common::Session->new(
        storageModule        => $args->{backend},
        storageModuleOptions => $args,
        id                   => $id,
    );

    unless ( $session->data ) {
        die "Error while opening session $id";
    }

    unless ( $session->update( { _2fDevices => to_json($_2fDevices) } ) ) {
        die "Error while updating session $id";
    }
}

sub convert_device_for_user {
    my ( $uid, $device ) = @_;
    my $changed = 0;

    if ( not exists $device->{_digits} ) {
        $device->{_digits} = $digits;
        $changed = 1;
    }

    if ( not exists $device->{_interval} ) {
        $device->{_interval} = $interval;
        $changed = 1;
    }

    if ( not exists $device->{_hash} ) {
        $device->{_hash} = $algorithm;
        $changed = 1;
    }

    if ($changed) {
        if ($dryrun) {
            info 'Will update device for ' . $uid;
        }
        else {
            info 'Updated device for ' . $uid;
        }
    }
    else {
        verbose 'Secret is already migrated';
    }
    return $changed;
}

sub convert_registrations_for_user {
    my ( $uid, $devices ) = @_;
    my $has_totp = 0;
    my $changed  = 0;
    for my $device ( @{$devices} ) {
        if ( $device->{type} eq "TOTP" ) {
            $has_totp = 1;
            my $epoch = $device->{epoch};
            verbose "Processing device with epoch $epoch for user $uid";
            my $changed_current = convert_device_for_user( $uid, $device );
            $changed = 1 if $changed_current;
        }
    }

    if ( !$has_totp ) {
        verbose "User $uid does not have a TOTP";
    }
    return $changed;
}

__END__

=encoding utf8

=head1 NAME

migrateTotpSecrets - A tool to migrate TOTP secrets from LemonLDAP 2.0

=head1 SYNOPSIS

  migrateTotpSecrets [options]

Options:

  --dry-run     Do not save modified sessions
  --verbose     Additional verbose output
  --interval    Interval for unmigrated secrets
  --digits      Digit count for unmigrated secrets
  --algorithm   Algorithm for unmigrated secrets

=head1 DESCRIPTION

Starting with LemonLDAP::NG 3.0, TOTP secrets can now use different parameters
(algorithms, interval, length).

However this requires the registration-time parameters to be stored along with
the TOTP secret, which was not done in LemonLDAP::NG 2.0. This script allows
you to migrate the TOTP storage format to include this information, this making
currently stored TOTP compatible with future parameter changes.

=head1 OPTIONS

=over 8

=item B<--help>, B<-h>

Print a brief help message and exit.

=item B<--dry-run>, B<-n>

Prevent the script from saving modifications to the session database

=item B<--interval>, B<-i>

The time interval to use for existing, unmigrated TOTP secrets. In seconds.
This value is usually set to 30.

=item B<--algorithm>, B<-a>

The hash algorithm to use for existing, unmigrated TOTP secrets. One of `sha1`,
`sha256`, `sha512`. This value is usually set to `sha1`.

=item B<--digits>, B<-d>

The number of digits to use for existing, unmigrated TOTP secrets. This value
is usually set to 6.

=item B<--verbose>, B<-v>

Increase the level of details provided by the script

=back


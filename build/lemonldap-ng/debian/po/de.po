msgid ""<br>
msgstr ""<br>
"Project-Id-Version: lemonldap-ng 0.8.3.1-1\n"<br>
"Report-Msgid-Bugs-To: x.guimard@free.fr\n"<br>
"POT-Creation-Date: 2007-09-22 13:08+0200\n"<br>
"PO-Revision-Date: 2008-01-23 23:12+0100\n"<br>
"Last-Translator: Helge Kreutzmann &lt;debian@helgefjell.de&gt;\n"<br>
"Language-Team: de &lt;debian-l10n-german@lists.debian.org&gt;\n"<br>
